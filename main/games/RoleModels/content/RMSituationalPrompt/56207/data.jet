    },
    {
      "s": "",
      "t": "A",
      "n": "RevealJoke4"
    },
    {
      "s": "Qui appelle « malade » le plus souvent ? ",
      "t": "A",
      "v": "803593_1",
      "n": "RevealPrompt2"
    },
    {
      "s": "Faites votre meilleure diatribe en colère sur le trafic local. Et s’il vous plaît, ne vous retenez pas. ",
      "t": "A",
      "v": "803592_1",
      "n": "RevealPrompt1"
    },
    {
      "s": "Qui peut hausser les épaules avec le meilleur « je ne sais pas » ? ",
      "t": "A",
      "v": "807121_2",
      "n": "RevealPrompt4"
    },
    {
      "s": "Oh ouais... Quel est le nom de ton chien ? ",
      "t": "A",
      "v": "807120_1",
      "n": "RevealPrompt3"
    },
    {
      "s": "Enlevez cet horrible cône de son cou et portez-le comme une couronne. ",
      "t": "A",
      "v": "803588_1",
      "n": "RevealJoke3"
    },
    {
      "s": "",
      "t": "A",
      "n": "RevealPrompt6"
    },
    {
      "s": "La majorité vous considère comme une personne malade. Hourra! ",
      "t": "A",
      "v": "803587_1",
      "n": "RevealJoke2"
    },
    {
      "s": "Criez le nom de la personne qui arrive toujours trop tôt aux événements ! ",
      "t": "A",
      "v": "807122_1",
      "n": "RevealPrompt5"
    },
    {
      "s": "Je sais, vous l'avez réglé sur PM au lieu de AM... encore une fois. ",
      "t": "A",
      "v": "803586_1",
      "n": "RevealJoke1"
    },
    {
      "s": "Qui passe plus de temps à regarder par la fenêtre pour rien en particulier ? ",
      "t": "A",
      "n": "RevealPrompt8"
    },
    {
      "s": "Avez-vous pensé aux transports en commun ? ",
      "t": "A",
      "v": "803585_1",
      "n": "RevealJoke0"
    },
    {
      "s": "Qui serait également en retard parce que, sur le chemin du travail, ils ont récupéré un animal errant sur le bord de la route ? ",
      "t": "A",
      "n": "RevealPrompt7"
    },
    {
      "s": "Qui a tendance à paraître plus somnolent ? ",
      "t": "A",
      "v": "803591_1",
      "n": "RevealPrompt0"
    },
    {
      "s": "Quelle excuse pour être en retard convient le mieux à chacun d’entre vous ? ",
      "t": "A",
      "v": "803578_1",
      "n": "Prompt"
    }
  ]
}
