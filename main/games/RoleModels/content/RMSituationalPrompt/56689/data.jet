    {
      "s": "Miam miam miam.",
      "t": "A",
      "v": "812300_1",
      "n": "RevealJoke5"
    },
    {
      "s": "Vous n’avez pas besoin d’ordonnance pour cela.",
      "t": "A",
      "v": "812299_1",
      "n": "RevealJoke4"
    },
    {
      "s": "Faites de votre mieux la voix de « petite fille possédée par le diable ». ",
      "t": "A",
      "n": "RevealPrompt0"
    },
    {
      "s": "Pourquoi tu es autant nul ? ",
      "t": "A",
      "n": "RevealPrompt1"
    },
    {
      "s": "Quelle pratique médicale dépassée êtes-vous ? ",
      "t": "A",
      "v": "812288_1",
      "n": "Prompt"
    },
    {
      "s": "Ce n’est pas une chirurgie cérébrale. Attendez. ",
      "t": "A",
      "v": "812298_1",
      "n": "RevealJoke3"
    },
    {
      "s": "Ça descend en douceur. ",
