            "text": "Lignes du discours de Liam Neeson dans <i>Taken<\\/i> ",
            "choices": [
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cJe ne sais pas qui tu es.\\u201d "
