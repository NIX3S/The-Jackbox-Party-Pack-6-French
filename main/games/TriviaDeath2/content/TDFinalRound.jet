        {
            "x": false,
            "id": 55335,
            "text": "Les règles de rangement de Marie Kondo ",
            "choices": [
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cEngagez-vous à faire du rangement\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cImaginez votre style de vie idéal\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cTerminez d'abord de vous débarrasser\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201c Ranger par catégorie, pas par emplacement \\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cSuivez le bon ordre\\u201d "
                },
                {
                    "difficulty": -1,
                    "correct": true,
                    "text": "\\u201cDemandez-vous si cela suscite de la joie\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "\\u201cBloquez des journées entières pour le nettoyage\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "\\u201cNe vous laissez pas submerger par l'émotion\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "\\u201cSupprimez d'abord ce que vous aimez le plus\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "\\u201cRemplissez votre maison de musique, pas de choses\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "\\u201cRangez chaque espace deux fois\\u201d "
                },
                {
                    "difficulty": -1,
                    "correct": false,
                    "text": "\\u201cNe parlez pas de rangement\\u201d "
                }
            ],
            "us": false
        },
