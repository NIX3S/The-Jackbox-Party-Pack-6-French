        {
            "x": false,
            "id": 55251,
            "text": "Citations de Shakespeare ",
            "choices": [
                {
                    "difficulty": -1,
                    "correct": true,
                    "text": "\\u201cÊtre ou ne pas être ?\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cPour que ton propre moi soit vrai.\\u201d "
                },
                {
                    "difficulty": -1,
                    "correct": true,
                    "text": "\\u201cPourquoi es-tu Roméo?\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cLa dame proteste trop\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cAttention aux ides de mars.\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cC'est maintenant l'hiver de notre mécontentement.\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cMon royaume pour un cheval !\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cAmène-toi dans un couvent\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cLa brièveté est l'âme de l'esprit.\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": true,
                    "text": "\\u201cCe qui est fait est fait.\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "\\u201cQuoth the Raven, \\u2018Jamais plus\\u2019\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "\\u201cLa terreur m'a rendu cruel\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "Du cœur de l'enfer, je te poignarde. "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "\\u201cCela pèse pour toi.\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "\\u201cÔ Capitaine ! Mon capitaine !\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "\\u201cAucun homme n’est une île.\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "\\u201cSi vous le construisez, il viendra.\\u201d "
                },
                {
                    "difficulty": 0,
                    "correct": false,
                    "text": "\\u201cVous ne pouvez\\u2019 pas gérer la vérité !\\u201d "
                },
                {
                    "difficulty": -1,
                    "correct": false,
                    "text": "\\u201cPersonne ne met bébé dans un coin.\\u201d "
                }
            ],
            "us": false
        },
